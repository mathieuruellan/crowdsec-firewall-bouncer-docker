{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": ["https://github.com/crowdsecurity/cs-firewall-bouncer/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/"],
      "depNameTemplate": "crowdsecurity/cs-firewall-bouncer",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["crowdsecurity/cs-firewall-bouncer"],
      "ignorePrerelease": true,
      "versioning": "semver"
    }
  ]
}
