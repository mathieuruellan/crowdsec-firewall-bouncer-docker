{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": true,
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "https://github.com/crowdsecurity/cs-firewall-bouncer/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/",
        "crowdsec-firewall-bouncer-v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "crowdsecurity/cs-firewall-bouncer",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["crowdsecurity/cs-firewall-bouncer"],
      "ignoreUnstable": true,
      "versioning": "semver"
    },
    {
      "description": "Major updates: manual review, never auto-merge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "GitHub Actions: no shipped image impact; auto-merge non-major without release/tag bump",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "platformAutomerge": true,
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Image-impacting deps (Dockerfile base, bouncer binary via regex manager): auto-merge non-major; release proposal must follow AGENTS immutable-tag rules",
      "matchManagers": ["dockerfile", "docker-compose", "regex", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
